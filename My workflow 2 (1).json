      },
      "id": "f9ca9676-d45a-43f2-b5fc-c361b522eeda",
      "name": "Domain Purchase Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -480,
        64
      ],
      "webhookId": "purchase-domain-webhook-id"
