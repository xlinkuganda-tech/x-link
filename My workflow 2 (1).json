    {
      "parameters": {
        "jsCode": "// 1. Extract incoming payment, domain, and merchant details\nconst inputData = $input.first().json;\nconst body = inputData.body || inputData;\nconst requestedDomain = String(body.purchased_domain || '').toLowerCase().trim();\nconst merchantSlug = body.slug || '';\nconst merchantEmail = body.merchant_email || 'support@xlinkug.com';\nconst merchantName = body.merchant_name || 'X-Link Merchant';\nconst apiToken = body.cloudflare_api_token || '';\n\nif (!requestedDomain) {\n  return [{ json: { success: false, error: \"No target domain provided for provisioning.\" } }];\n}\n\nreturn [{\n  json: {\n    requestedDomain,\n    merchantSlug,\n    merchantEmail,\n    merchantName,\n    apiToken\n  }\n}];"
      },
      "id": "692f3097-6bc0-439f-8888-75cdfcf8ad0d",
      "name": "Parse Domain Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        64
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/accounts/1170c73b3244e4c3da0eb74a18e83055/registrar/domain-check",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "cloudflareApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domains\": [\"{{ $json.requestedDomain }}\"]\n}",
        "options": {}
      },
      "id": "c1a7e0d4-5b82-4f39-a6d1-7e0c9b2f4a58",
      "name": "Check Domain Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -48,
        64
      ],
      "credentials": {
        "cloudflareApi": {
          "id": "vSZFynKD6yiSQXwE",
          "name": "Cloudflare account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parse Domain Request').first().json;\nconst res = $input.first().json || {};\nconst body = res.body || res;\nconst entry = Array.isArray(body.domains) && body.domains.length > 0 ? body.domains[0] : {};\n\nconst registrable = entry.registrable === true;\nconst pricing = entry.pricing || {};\nconst reason = entry.reason || '';\n\nconst REASON_TEXT = {\n  domain_unavailable: 'that domain is already taken.',\n  domain_premium: 'that domain is premium priced, which the registrar API cannot register.',\n  extension_not_supported: 'that domain extension is not supported.',\n  extension_not_supported_via_api: 'that domain extension can only be registered in the Cloudflare dashboard.',\n  extension_disallows_registration: 'that domain extension is not accepting new registrations.'\n};\n\nreturn [{\n  json: {\n    ...parsed,\n    available: registrable,\n    reason,\n    reasonText: REASON_TEXT[reason] || 'that domain cannot be registered right now.',\n    price: pricing.registration_cost || '',\n    currency: pricing.currency || '',\n    message: registrable\n      ? 'Good news: ' + parsed.requestedDomain + ' is available' + (pricing.registration_cost ? ' at ' + pricing.currency + ' ' + pricing.registration_cost + ' for the first year.' : '.')\n      : 'Sorry, ' + (REASON_TEXT[reason] || 'that domain cannot be registered right now.')\n  }\n}];"
      },
      "id": "d4b8f1c6-9a35-4e72-b8c4-1f6d0a3e7b29",
      "name": "Decide Availability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-available",
              "leftValue": "={{ $json.available }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e6c2a8b7-3d41-4a95-9f28-5b7e1c0d6a43",
      "name": "Only If Available",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        416,
