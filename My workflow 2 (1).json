    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/accounts/1170c73b3244e4c3da0eb74a18e83055/registrar/registrations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "cloudflareApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domain\": \"{{ $json.requestedDomain }}\",\n  \"auto_renew\": true,\n  \"registrant_contact\": {\n    \"email\": \"{{ $json.merchantEmail }}\",\n    \"name\": \"{{ $json.merchantName }}\"\n  }\n}",
        "options": {}
      },
      "id": "34753c89-2fd8-40f6-8bee-c5d6556c1fcc",
      "name": "Cloudflare Registrar API1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        256,
        -96
      ],
      "credentials": {
        "cloudflareApi": {
          "id": "vSZFynKD6yiSQXwE",
          "name": "Cloudflare account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.cloudflare.com/client/v4/zones/fe1040dbba63cac54a1d4a9f8d72fdd6/dns_records",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "cloudflareApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"CNAME\",\n  \"name\": \"{{ $('Parse Domain Request').first().json.requestedDomain }}\",\n  \"content\": \"orchid-frigatebird.pikapod.net\",\n  \"ttl\": 1,\n  \"proxied\": true\n}",
        "options": {}
      },
      "id": "b8d4bb3e-cd35-4a2f-991f-4bf4ab5d6b6e",
      "name": "Configure Cloudflare CNAME DNS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        496,
        64
      ],
      "credentials": {
        "cloudflareApi": {
          "id": "vSZFynKD6yiSQXwE",
          "name": "Cloudflare account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst parsedInput = $('Parse Domain Request').first().json;\nconst requestedDomain = parsedInput.requestedDomain;\nconst merchantSlug = parsedInput.merchantSlug;\n\nlet provisioningStatus = 'ACTIVE';\nlet errorDetails = null;\n\ntry {\n  // Save mapping to global workflow static data for the router\n  const staticData = $getWorkflowStaticData('global');\n  staticData.customDomains = staticData.customDomains || {};\n  staticData.customDomains[requestedDomain] = merchantSlug;\n} catch (error) {\n  provisioningStatus = 'ERROR';\n  errorDetails = error.message;\n}\n\nreturn [{\n  json: {\n    success: provisioningStatus === 'ACTIVE',\n    domain: requestedDomain,\n    slug: merchantSlug,\n    live_url: `https://${requestedDomain}`,\n    status: provisioningStatus,\n    error: errorDetails,\n    message: `Success! Domain ${requestedDomain} purchased, DNS mapped to PikaPods, and proxied live.`\n  }\n}];"
      },
      "id": "a4e2ef63-f57c-496c-a67c-0c188e1e9d0b",
      "name": "Finalize Global Mapping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        64
      ]
    },
